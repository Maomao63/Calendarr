# Docker image with the rolling latest tag.
CALENDARR_IMAGE=ghcr.io/maomao63/calendarr:latest

# Host directory containing config.json. Relative paths are resolved next to compose.yaml.
CALENDARR_CONFIG_PATH=./config

# Existing Docker network shared by Calendarr, Sonarr and Radarr.
MEDIA_NETWORK=media

# Published port on the Docker host.
CALENDARR_PORT=3000
